@using Octans.Core.Stats
@using Octans.Core.Tags
@inject ILocalFileImportViewmodel Viewmodel
@inject StorageService StorageService
@inject IDialogService DialogService

<div class="file-input-wrapper">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" @bind-Files="Viewmodel.LocalFiles">
        <ActivatorContent>
            <MudButton
                Class="choose-files-button"
                Variant="Variant.Filled"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.CloudUpload">
                Choose files
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>
</div>

@if (Viewmodel.LocalFiles.Count > 0)
{
    <div class="file-list">
        <h5>Selected files <span>@Viewmodel.LocalFiles.Count</span></h5>
        @foreach (var file in Viewmodel.LocalFiles)
        {
            <div class="file-item">
                <span>@file.Name</span>
                <span>@StorageService.FormatFileSize(file.Size)</span>
            </div>
        }
    </div>
    
    <div class="import-actions">
        <MudButton
            Variant="Variant.Outlined"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Tag"
            OnClick="@OpenTagChooser"
            Disabled="@(Viewmodel.LocalFiles.Count == 0)">
            Add Tags
        </MudButton>
        <MudCheckBox @bind-Value="Viewmodel.AutoArchive" Label="Auto Archive" Color="Color.Primary"></MudCheckBox>
    </div>
}

<MudButton
    Class="send-button"
    Variant="Variant.Filled"
    Color="Color.Primary"
    OnClick="@ImportFiles"
    Disabled="@(Viewmodel.LocalFiles.Count == 0)">
    Import
</MudButton>

@if (Viewmodel.LastJobId is not null)
{
    <section class="results">
        <p>Import job queued: @Viewmodel.LastJobId</p>
    </section>
}

@code {
    private TagChooser.TagChooserResult? TagChooserResult { get; set; }

    private async Task ImportFiles()
    {
        Dictionary<string, IEnumerable<TagModel>>? tags = null;
        if (TagChooserResult is not null)
        {
            tags = TagChooserResult
                .GenerateTagsForPaths()
                .ToDictionary(
                    k => k.Path,
                    v => v.Tags.Select(t => new TagModel(t.Namespace, t.Subtag))
                );
        }

        await Viewmodel.SendLocalFilesToServer(tags);
    }

    private async Task OpenTagChooser()
    {
        var parameters = new DialogParameters<TagChooserDialog>
        {
            { x => x.Paths, Viewmodel.LocalFiles.Select(f => f.Name) }
        };

        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<TagChooserDialog>("Add Tags", parameters, options);
        var result = await dialog.Result;

        if (result is {Canceled: false, Data: TagChooser.TagChooserResult tagResult})
        {
            TagChooserResult = tagResult;
        }
    }
}
