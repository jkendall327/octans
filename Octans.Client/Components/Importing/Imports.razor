@page "/imports"
@inject NavigationManager NavigationManager

<div class="imports-container">
    <header class="imports-header">
        <div>
            <p class="imports-kicker">Repository</p>
            <h1>Import</h1>
        </div>
    </header>

    <div class="import-tabs">
        <MudTabs
            @bind-ActivePanelIndex="_activeTabIndex"
            Rounded="false"
            Elevation="0"
            Class="imports-tabs-control">
            <MudTabPanel Text="Files">
                <div class="upload-section">
                    <LocalFileImport/>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="URL">
                <div class="url-section">
                    <RawUrlImport/>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Post">
                <!-- TODO: Implement Post Import tab -->
                <p class="import-placeholder">Post imports are not implemented yet.</p>
            </MudTabPanel>
            <MudTabPanel Text="Gallery">
                <!-- TODO: Implement Gallery Import tab -->
                <p class="import-placeholder">Gallery imports are not implemented yet.</p>
            </MudTabPanel>
            <MudTabPanel Text="Watchable">
                <!-- TODO: Implement Watchable Import tab -->
                <p class="import-placeholder">Watchable imports are not implemented yet.</p>
            </MudTabPanel>
        </MudTabs>
    </div>

    <ImportJobsPanel/>
</div>

@code {
    private int _activeTabIndex;

    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        if (Tab is null) return;

        _activeTabIndex = Tab switch
        {
            "files" => 0,
            "url" => 1,
            "gallery" => 3,
            "watchable" => 4,
            _ => 0
        };
    }
}
