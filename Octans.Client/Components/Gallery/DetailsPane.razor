@using Octans.Client.Services
@using Octans.Core.Notes
@inject DetailsPaneViewmodel Viewmodel
@implements IDisposable

@if (Viewmodel.HasSelection)
{
    <div class="details-pane">
        <section class="file-info">
            <MudText Typo="Typo.h6">File Details</MudText>
            <MudText Typo="Typo.body2">Hash: @Viewmodel.SelectedHash</MudText>

            <div class="actions mt-2">
                 <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Archive"
                           OnClick="@Viewmodel.ArchiveImage">
                     Archive
                 </MudButton>

                  <MudButton Variant="Variant.Outlined"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Inbox"
                            OnClick="@Viewmodel.InboxImage"
                            Class="ml-2">
                      To Inbox
                  </MudButton>
            </div>
        </section>

        <section class="tags-section">
             <TagViewer Tags="@Viewmodel.Tags" />
        </section>

        <section class="notes-section">
            <MudText Typo="Typo.h6">Notes</MudText>
            <MudList T="NoteDto" Dense="true">
                @foreach (var note in Viewmodel.Notes)
                {
                    <MudListItem>
                        <MudCard Outlined="true" Class="pa-2 mb-2">
                             <MudCardContent>
                                 <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@note.Content</MudText>
                                 <MudText Typo="Typo.caption" Color="Color.Secondary">@Formatting.FormatLocalTime(note.CreatedAt)</MudText>
                             </MudCardContent>
                             <MudCardActions>
                                 <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Viewmodel.DeleteNote(note))" Color="Color.Error" />
                             </MudCardActions>
                        </MudCard>
                    </MudListItem>
                }
            </MudList>

            <MudTextField @bind-Value="Viewmodel.NewNoteContent" Label="Add a note" Variant="Variant.Outlined" Lines="3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Viewmodel.AddNote" Disabled="@(!Viewmodel.CanAddNote)" Class="mt-2">Add Note</MudButton>
        </section>
    </div>
}
else
{
    <div class="empty-state">
        <MudText Typo="Typo.body1">Select an image to view details.</MudText>
    </div>
}

@code {
    [Parameter]
    public string? SelectedHash { get; set; }

    protected override void OnInitialized()
    {
        Viewmodel.StateChanged += Refresh;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Viewmodel.SelectHashAsync(SelectedHash);
    }

    private Task Refresh()
    {
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Viewmodel.StateChanged -= Refresh;
    }
}

<style>
    .details-pane {
        padding: 10px;
        overflow-y: auto;
        height: 100%;
    }

    .file-info {
        margin-bottom: 20px;
    }

    .notes-section {
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        color: #888;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
    }

    .ml-2 {
        margin-left: 0.5rem;
    }
</style>
