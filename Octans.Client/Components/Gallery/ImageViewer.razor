@inject ShellService ShellService
@inject IDialogService DialogService
@inject ImageViewerViewmodel Viewmodel
@using Octans.Client.Components.Settings
@using Octans.Client.Services
@implements IDisposable

<div class="image-viewer"
     tabindex="0"
     @ref="_root"
     @onkeydown="OnKeyDown"
>
    <section class="toolbar">
        <MudButton
            OnClick="@(OnClose)"
            Size="Size.Small"
            Class="mr-n3 mb-1"
            Color="Color.Error">
            Close
        </MudButton>
        <MudButton
            OnClick="@PreviousAsync"
            Disabled="@(Viewmodel.CurrentImage is null)"
            Size="Size.Small"
            Class="mr-n3 mb-1"
            Color="Color.Default">
            Previous
        </MudButton>

        <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Size="Size.Small" OnClick="@OpenKeybindingManager" Class="mb-1" />

        @if (FilterMode)
        {
            <MudButton
                OnClick="@ArchiveAsync"
                Disabled="@(Viewmodel.CurrentImage is null)"
                Size="Size.Small"
                Class="mr-n3 mb-1"
                Color="Color.Success">
                Archive
            </MudButton>

            <MudButton
                OnClick="@DeleteAsync"
                Disabled="@(Viewmodel.CurrentImage is null)"
                Size="Size.Small"
                Class="mr-n3 mb-1"
                Color="Color.Error">
                Delete
            </MudButton>
        }
        <MudButton
            OnClick="@NextAsync"
            Disabled="@(Viewmodel.CurrentImage is null)"
            Size="Size.Small"
            Class="mr-n3 mb-1"
            Color="Color.Default">
            Next
        </MudButton>
    </section>

    <section class="media-plane" @ondblclick="@OnClose">
        <div class="tag-list">
            @if (Viewmodel.Tags is null)
            {
                <p>Loading...</p>
            }
            else
            {
                @foreach (var tag in Viewmodel.Tags)
                {
                    <p>@tag.Namespace:@tag.Subtag</p>
                }
            }
        </div>
        <div class="image-display" @onmousedown="OnImageMouseDown" @oncontextmenu:preventDefault>
            @if (Viewmodel.CurrentImage is null)
            {
                <p>Loading...</p>
            }
            else
            {
                <img
                    src="@Viewmodel.CurrentImage"
                    alt="Gallery image"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"/>
            }
        </div>
    </section>
</div>


@code {
    private ElementReference _root;
    private bool _shouldFocus;
    private bool _subscribed;

    [Parameter, EditorRequired] public List<string> ImageUrls { get; set; } = [];
    [Parameter] public string? StartingImage { get; set; }
    [Parameter] public EventCallback<string> CurrentImageChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool FilterMode { get; set; }
    [Parameter] public EventCallback<ImageViewerFilterResult> OnFilterComplete { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!_subscribed)
        {
            Viewmodel.StateChanged += Refresh;
            _subscribed = true;
        }

        _shouldFocus = true;
        ShellService.HideShell();
        await Viewmodel.InitializeAsync(ImageUrls, StartingImage, FilterMode);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocus)
        {
            _shouldFocus = false;
            await _root.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        await RunViewerActionAsync(() => Viewmodel.HandleKeyDownAsync(e));
    }

    private async Task OpenKeybindingManager()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<KeybindingManager>("Keyboard Shortcuts", options);
    }

    private async Task PreviousAsync()
    {
        await RunViewerActionAsync(Viewmodel.PreviousAsync);
    }

    private async Task NextAsync()
    {
        await RunViewerActionAsync(Viewmodel.NextAsync);
    }

    private async Task ArchiveAsync()
    {
        await RunViewerActionAsync(Viewmodel.ArchiveAsync);
    }

    private async Task DeleteAsync()
    {
        await RunViewerActionAsync(Viewmodel.DeleteAsync);
    }

    private async Task OnImageMouseDown(MouseEventArgs e)
    {
        await RunViewerActionAsync(() => Viewmodel.HandleImageMouseDownAsync(e.Button));
    }

    private async Task RunViewerActionAsync(Func<Task<ImageViewerAction>> actionFactory)
    {
        var previousImage = Viewmodel.CurrentImage;

        await ApplyActionAsync(await actionFactory());

        if (Viewmodel.CurrentImage is not null && Viewmodel.CurrentImage != previousImage)
        {
            await CurrentImageChanged.InvokeAsync(Viewmodel.CurrentImage);
        }
    }

    private async Task ApplyActionAsync(ImageViewerAction action)
    {
        if (action.CloseRequested)
        {
            await OnClose.InvokeAsync();
            return;
        }

        if (action.CommitPromptRequested)
        {
            await PromptCommitAsync(action);
        }
    }

    private async Task PromptCommitAsync(ImageViewerAction action)
    {
        var result = await DialogService.ShowMessageBox("Finished", (MarkupString) "All images have been marked.", yesText: "Commit", noText: "Cancel", cancelText: "Stay");

        switch (result)
        {
            case true:
                await OnFilterComplete.InvokeAsync(Viewmodel.CreateFilterResult());
                await OnClose.InvokeAsync();
                break;
            case false:
                await OnClose.InvokeAsync();
                break;
            default:
                await Viewmodel.StayAfterPromptAsync(action);
                break;
        }
    }

    private Task Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribed)
        {
            Viewmodel.StateChanged -= Refresh;
        }

        ShellService.ShowShell();
    }
}

<style>
    .image-viewer {
        display: flex;
        flex-direction: column;
        background: var(--background-color);
        justify-items: center;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    .media-plane {
        display: flex;
        flex-direction: row;
        justify-content: flex-start;

        padding: 0.3rem;
        flex: 1 1 0;
        min-height: 0;

    }

    .tag-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 10%;
    }

    .image-display {
        overflow-x: visible;
    }

    img {
        object-fit: contain;
        display: block;
        margin: auto;
        max-height: 100%;
        max-width: 100%;
        height: auto;
        width: auto;
    }

    .toolbar {
        display: flex;
        flex-direction: row;
        gap: 1em;
        align-items: center;
        border-bottom: 1px solid;
    }
</style>
