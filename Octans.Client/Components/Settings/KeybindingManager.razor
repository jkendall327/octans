@using Octans.Client.Settings
@inject KeybindingManagerViewmodel Viewmodel
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="4">
                <MudText Typo="Typo.h6">Sets</MudText>
                <MudList T="KeybindingSet" SelectedValue="Viewmodel.SelectedSet" SelectionMode="SelectionMode.SingleSelection" SelectedValueChanged="Viewmodel.SelectSet">
                    @foreach (var set in Viewmodel.Sets)
                    {
                        <MudListItem Value="set">
                             <div class="d-flex justify-space-between align-center">
                                 <MudText>@set.Name @(set.Id == Viewmodel.ActiveSetId ? "(Active)" : "")</MudText>
                             </div>
                        </MudListItem>
                    }
                </MudList>
                <MudButton OnClick="@Viewmodel.CreateSet" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">New Set</MudButton>
            </MudItem>
            <MudItem xs="8">
                @if (Viewmodel.SelectedSet != null)
                {
                    <MudText Typo="Typo.h6">Edit: @Viewmodel.SelectedSet.Name</MudText>
                    <div class="d-flex gap-2 mb-4">
                        <MudButton OnClick="@Viewmodel.ActivateSelectedSet" Disabled="@(Viewmodel.SelectedSet.Id == Viewmodel.ActiveSetId)" Variant="Variant.Filled" Color="Color.Secondary">Activate</MudButton>
                        <MudButton OnClick="@Viewmodel.DeleteSelectedSet" Color="Color.Error" Variant="Variant.Outlined">Delete Set</MudButton>
                        <MudTextField @bind-Value="Viewmodel.SelectedSet.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="500" OnDebounceIntervalElapsed="Viewmodel.SaveSelectedSet" />
                    </div>

                    <MudTable Items="Viewmodel.SelectedSet.Keybindings" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Key</MudTh>
                            <MudTh>Modifiers</MudTh>
                            <MudTh>Action</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Key">@context.Key</MudTd>
                            <MudTd DataLabel="Modifiers">@KeybindingManagerViewmodel.GetModifiersString(context)</MudTd>
                            <MudTd DataLabel="Action">@context.ActionId</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Viewmodel.RemoveKeybinding(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle1">Add Keybinding</MudText>
                        <div class="d-flex gap-2 align-end">
                            <MudTextField @bind-Value="Viewmodel.NewKey" Label="Key (e.g. A, ArrowLeft)" />
                            <MudCheckBox @bind-Value="Viewmodel.NewCtrl" Label="Ctrl" />
                            <MudCheckBox @bind-Value="Viewmodel.NewShift" Label="Shift" />
                            <MudCheckBox @bind-Value="Viewmodel.NewAlt" Label="Alt" />
                            <MudSelect @bind-Value="Viewmodel.NewAction" Label="Action">
                                <MudSelectItem Value="@KeybindingActions.Next">Next</MudSelectItem>
                                <MudSelectItem Value="@KeybindingActions.Previous">Previous</MudSelectItem>
                                <MudSelectItem Value="@KeybindingActions.Archive">Archive</MudSelectItem>
                                <MudSelectItem Value="@KeybindingActions.Delete">Delete</MudSelectItem>
                                <MudSelectItem Value="@KeybindingActions.Inbox">Inbox</MudSelectItem>
                                <MudSelectItem Value="@KeybindingActions.Close">Close</MudSelectItem>
                            </MudSelect>
                            <MudButton OnClick="@Viewmodel.AddKeybinding" Variant="Variant.Filled" Color="Color.Primary">Add</MudButton>
                        </div>
                    </MudPaper>
                }
                else
                {
                    <MudText>Select a set to edit.</MudText>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    private bool _subscribed;

    protected override async Task OnInitializedAsync()
    {
        Viewmodel.StateChanged += Refresh;
        _subscribed = true;
        await Viewmodel.InitializeAsync();
    }

    private Task Refresh() => InvokeAsync(StateHasChanged);

    private void Close() => MudDialog?.Close(DialogResult.Ok(true));

    public void Dispose()
    {
        if (_subscribed)
        {
            Viewmodel.StateChanged -= Refresh;
        }
    }
}
